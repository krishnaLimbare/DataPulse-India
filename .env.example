# Copy to .env (git-ignored) and fill in. In CI, set these as repository secrets.
# Nested settings use a double underscore: DATAPULSE_API_KEYS__<NAME>

DATAPULSE_LOG_LEVEL=INFO
DATAPULSE_ENVIRONMENT=local

# data.gov.in free API key — https://data.gov.in/help/how-use-datasets-apis
DATAPULSE_API_KEYS__DATA_GOV_IN=
